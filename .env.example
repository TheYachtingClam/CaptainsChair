# Copy to .env and fill in. scripts/start.sh creates .env for you if it is missing.

# Random secret used to sign session cookies. At least 16 characters.
SESSION_SECRET=replace-with-a-long-random-string

# Cookies are HTTPS-only by default. Set to false only when running over plain HTTP locally.
SECURE_COOKIES=false

# Port on your machine for docker compose.
PORT=8000

LOG_LEVEL=info

# Developer panel for testing cards by hand (plans/card-implementation.md). Leave off for real games.
DEV_TOOLS=false

# Accounts (requirements/19-technical-architecture.md §5). Everyone signs in with their own account, made by invitation.
# The first admin invitation goes here: python -m app.create_admin
ADMIN_EMAIL=

# The site's address, for links in emails.
PUBLIC_URL=http://localhost:8000

# Sending email through a Gmail account with an app password (REQ-USER-23). Without SMTP_PASSWORD, emails are
# written to the server log instead. Create the app password in your Google account (it needs 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: the sender. Blank means "Captain's Chair Online" at SMTP_USER.
MAIL_FROM=
